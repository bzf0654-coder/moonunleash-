///|
fn unicode_verdict_field(value : @json.Json, key : String) -> @json.Json {
  match value {
    Object(fields) => fields.get(key).unwrap_or(@json.null)
    _ => @json.null
  }
}

///|
fn unicode_verdict_text(value : @json.Json) -> String raise {
  guard value is String(text) else { fail("expected generated Unicode text") }
  text
}

