iant","name":"ascii-feature-3","context":{"userId":"😊"},"kind":"variant","expected":{"name":"disabled","enabled":false,"feature_enabled":false}},{"id":"unicode-extra:3:全局-é:boolean","name":"全局-é","context":{"userId":"😊"},"kind":"boolean","expected":true},{"id":"unicode-extra:3:全局-é:variant","name":"全局-é","context":{"userId":"😊"},"kind":"variant","expected":{"name":"treatment","enabled":true,"feature_enabled":true,"payload":{"type":"string","value":"blue"}}},{"id":"unicode-extra:3:全局-é:boolean","name":"全局-é","context":{"userId":"😊"},"kind":"boolean","expected":true},{"id":"unicode-extra:3:全局-é:variant","name":"全局-é","context":{"userId":"😊"},"kind":"variant","expected":{"name":"treatment","enabled":true,"feature_enabled":true,"payload":{"type":"string","value":"blue"}}},{"id":"unicode-extra:3:全局-🌍:boolean","name":"全局-🌍","context":{"userId":"😊"},"kind":"boolean","expected":true},{"id":"unicode-extra:3:全局-🌍:variant","name":"全局-🌍","context":{"userId":"😊"},"kind":"variant","expected":{"name":"control","enabled":true,"feature_enabled":true}},{"id":"unicode-extra:3:全局-用户:boolean","name":"全局-用户","context":{"userId":"😊"},"kind":"boolean","expected":true},{"id":"unicode-extra:3:全局-用户:variant","name":"全局-用户","context":{"userId":"😊"},"kind":"variant","expected":{"name":"treatment","enabled":true,"feature_enabled":true,"payload":{"type":"string","value":"blue"}}}]}]
  guard @json.parse(source) is Array(groups) else {
    fail("expected generated Unicode groups")
  }
  let mut count = 0
  for group in groups {
    let state = Snapshot::parse(
      unicode_verdict_field(group, "state").stringify(),
    )
    guard unicode_verdict_field(group, "cases") is Array(cases) else {
      fail("expected generated Unicode cases")
    }
    for c in cases {
      let name = unicode_verdict_text(unicode_verdict_field(c, "name"))
      let ctx = Context::parse(unicode_verdict_field(c, "context").stringify())
      let actual = if unicode_verdict_text(unicode_verdict_field(c, "kind")) ==
        "variant" {
        state.get_variant(name, ctx).to_json()
      } else {
        @json.Json::boolean(state.evaluate(name, ctx).enabled)
      }
      assert_eq(
        actual,
        unicode_verdict_field(c, "expected"),
        msg=unicode_verdict_text(unicode_verdict_field(c, "id")),
      )
      count = count + 1
    }
  }
  assert_eq(count, 112)
}
